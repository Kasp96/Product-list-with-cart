<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Frontend Mentor | Product list with cart</title>
  <!-- @include 'styles.kit' -->
</head>

<body>
  <div class="app py-4 px-4">
    <h1 class="app-heading">Desserts</h1>
    <div class="products-container">
      <div class="product-card d-flex flex-column">
        <div class="product-img-box position-relative">
          <picture>
            <source srcset="./images/image-waffle-desktop.jpg" media="(min-width: 1024px)">
            <source srcset="./images/image-waffle-tablet.jpg" media="(min-width: 768px)">
            <img src="./images/image-waffle-mobile.jpg" alt="Waffle with Berries">
          </picture>
          <button class="product-btn add-to-cart-btn d-flex align-items-center gap-2 position-absolute d-non"><img
              src="../images/icon-add-to-cart.svg" alt="cart icon">
            Add
            to Cart</button>
          <button
            class="product-btn quantity-btn position-absolute d-flex justify-content-between align-items-center d-none">
            <img src="../images/icon-decrement-quantity.svg" alt="reduce quantity button">
            <span class="current-quantity">1</span>
            <img src="../images/icon-increment-quantity.svg" alt="">
          </button>
        </div>
        <div class="product-info">
          <h2 class="product-category mb-1">Waffle</h2>
          <p class="product-name">Waffle with Berries</p>
          <p class="price">$6.50</p>
        </div>
      </div>
      <div class="product-card d-flex flex-column">
        <div class="product-img-box position-relative">
          <picture>
            <source srcset="./images/image-creme-brulee-desktop.jpg" media="(min-width: 1024px)">
            <source srcset="./images/image-creme-brulee-tablet.jpg" media="(min-width: 768px)">
            <img src="./images/image-creme-brulee-mobile.jpg" alt="Waffle with Berries">
          </picture>
          <button class="add-to-cart-btn d-flex align-items-center gap-2 position-absolute"><img
              src="../images/icon-add-to-cart.svg" alt="cart icon">
            Add
            to Cart</button>
        </div>
        <div class="product-info">
          <h2 class="product-category mb-1">Crème Brûlée</h2>
          <p class="product-name">Vanilla Bean Crème Brûlée</p>
          <p class="price">$7.00</p>
        </div>
      </div>
      <div class="product-card d-flex flex-column">
        <div class="product-img-box position-relative">
          <picture>
            <source srcset="./images/image-macaron-desktop.jpg" media="(min-width: 1024px)">
            <source srcset="./images/image-macaron-tablet.jpg" media="(min-width: 768px)">
            <img src="./images/image-macaron-mobile.jpg" alt="Waffle with Berries">
          </picture>
          <button class="add-to-cart-btn d-flex align-items-center gap-2 position-absolute"><img
              src="../images/icon-add-to-cart.svg" alt="cart icon">
            Add
            to Cart</button>
        </div>
        <div class="product-info">
          <h2 class="product-category mb-1">Macaron</h2>
          <p class="product-name">Macaron Mix of Five</p>
          <p class="price">$8.00</p>
        </div>
      </div>
      <div class="product-card d-flex flex-column">
        <div class="product-img-box position-relative">
          <picture>
            <source srcset="./images/image-tiramisu-desktop.jpg" media="(min-width: 1024px)">
            <source srcset="./images/image-tiramisu-tablet.jpg" media="(min-width: 768px)">
            <img src="./images/image-tiramisu-mobile.jpg" alt="Waffle with Berries">
          </picture>
          <button class="add-to-cart-btn d-flex align-items-center gap-2 position-absolute"><img
              src="../images/icon-add-to-cart.svg" alt="cart icon">
            Add
            to Cart</button>
        </div>
        <div class="product-info">
          <h2 class="product-category mb-1">Tiramisu</h2>
          <p class="product-name">Classic Tiramisu</p>
          <p class="price">$5.50</p>
        </div>
      </div>
      <div class="product-card d-flex flex-column">
        <div class="product-img-box position-relative">
          <picture>
            <source srcset="./images/image-baklava-desktop.jpg" media="(min-width: 1024px)">
            <source srcset="./images/image-baklava-tablet.jpg" media="(min-width: 768px)">
            <img src="./images/image-baklava-mobile.jpg" alt="Waffle with Berries">
          </picture>
          <button class="add-to-cart-btn d-flex align-items-center gap-2 position-absolute"><img
              src="../images/icon-add-to-cart.svg" alt="cart icon">
            Add
            to Cart</button>
        </div>
        <div class="product-info">
          <h2 class="product-category mb-1">Baklava</h2>
          <p class="product-name">Pistachio Baklava</p>
          <p class="price">$4.00</p>
        </div>
      </div>
      <div class="product-card d-flex flex-column">
        <div class="product-img-box position-relative">
          <picture>
            <source srcset="./images/image-meringue-desktop.jpg" media="(min-width: 1024px)">
            <source srcset="./images/image-meringue-tablet.jpg" media="(min-width: 768px)">
            <img src="./images/image-meringue-mobile.jpg" alt="Waffle with Berries">
          </picture>
          <button class="add-to-cart-btn d-flex align-items-center gap-2 position-absolute"><img
              src="../images/icon-add-to-cart.svg" alt="cart icon">
            Add
            to Cart</button>
        </div>
        <div class="product-info">
          <h2 class="product-category mb-1">Pie</h2>
          <p class="product-name">Lemon Meringue Pie</p>
          <p class="price">$5.00</p>
        </div>
      </div>
      <div class="product-card d-flex flex-column">
        <div class="product-img-box position-relative">
          <picture>
            <source srcset="./images/image-cake-desktop.jpg" media="(min-width: 1024px)">
            <source srcset="./images/image-cake-tablet.jpg" media="(min-width: 768px)">
            <img src="./images/image-cake-mobile.jpg" alt="Waffle with Berries">
          </picture>
          <button class="add-to-cart-btn d-flex align-items-center gap-2 position-absolute"><img
              src="../images/icon-add-to-cart.svg" alt="cart icon">
            Add
            to Cart</button>
        </div>
        <div class="product-info">
          <h2 class="product-category mb-1">Cake</h2>
          <p class="product-name">Red Velvet Cake</p>
          <p class="price">$4.50</p>
        </div>
      </div>
      <div class="product-card d-flex flex-column">
        <div class="product-img-box position-relative">
          <picture>
            <source srcset="./images/image-brownie-desktop.jpg" media="(min-width: 1024px)">
            <source srcset="./images/image-brownie-tablet.jpg" media="(min-width: 768px)">
            <img src="./images/image-brownie-mobile.jpg" alt="Waffle with Berries">
          </picture>
          <button class="add-to-cart-btn d-flex align-items-center gap-2 position-absolute"><img
              src="../images/icon-add-to-cart.svg" alt="cart icon">
            Add
            to Cart</button>
        </div>
        <div class="product-info">
          <h2 class="product-category mb-1">Brownie</h2>
          <p class="product-name">Salted Caramel Brownie</p>
          <p class="price">$5.50</p>
        </div>
      </div>
      <div class="product-card d-flex flex-column">
        <div class="product-img-box position-relative">
          <picture>
            <source srcset="./images/image-panna-cotta-desktop.jpg" media="(min-width: 1024px)">
            <source srcset="./images/image-panna-cotta-tablet.jpg" media="(min-width: 768px)">
            <img src="./images/image-panna-cotta-mobile.jpg" alt="Waffle with Berries">
          </picture>
          <button class="add-to-cart-btn d-flex align-items-center gap-2 position-absolute"><img
              src="../images/icon-add-to-cart.svg" alt="cart icon">
            Add
            to Cart</button>
        </div>
        <div class="product-info">
          <h2 class="product-category mb-1">Panna Cotta</h2>
          <p class="product-name">Vanilla Panna Cotta</p>
          <p class="price">$6.50</p>
        </div>
      </div>
    </div>
    <div class="cart-panel p-4">
      <h2 class="cart-heading">Your Cart <span class="added-products-amount">(0)</span></h2>
      <div class="cart-body d-flex flex-column align-items-start">
        <!-- <img class="empty-cart-img" src="../images/illustration-empty-cart.svg" alt="empty-cart-image">
        <p class="empty-cart-info">Your added items will appear here</p> -->
        <div class="cart-item d-flex justify-content-between align-items-center w-100">
          <div>
            <h3 class="cart-item-name">Classic Tiramisu</h3>
            <div class="cart-item-price-box d-flex gap-2">
              <p class="cart-item-quantity me-2">1x</p>
              <p class="cart-item-price">@ $5.50</p>
              <p class="cart-item-total">$5.50</p>
            </div>
          </div>
          <button class="cart-item-remove d-flex justify-content-center align-items-center"><img
              src="../images/icon-remove-item.svg" alt="remove item icon"></button>
        </div>
        <div class="cart-item d-flex justify-content-between align-items-center w-100">
          <div>
            <h3 class="cart-item-name">Vanilla Bean Crème Brûlée</h3>
            <div class="cart-item-price-box d-flex gap-2">
              <p class="cart-item-quantity me-2">4x</p>
              <p class="cart-item-price">@ $7.00</p>
              <p class="cart-item-total">$28.00</p>
            </div>
          </div>
          <button class="cart-item-remove d-flex justify-content-center align-items-center"><img
              src="../images/icon-remove-item.svg" alt="remove item icon"></button>
        </div>
        <div class="cart-item d-flex justify-content-between align-items-center w-100">
          <div>
            <h3 class="cart-item-name">Vanilla Panna Cotta</h3>
            <div class="cart-item-price-box d-flex gap-2">
              <p class="cart-item-quantity me-2">2x</p>
              <p class="cart-item-price">@ $6.50</p>
              <p class="cart-item-total">$13.00</p>
            </div>
          </div>
          <button class="cart-item-remove d-flex justify-content-center align-items-center"><img
              src="../images/icon-remove-item.svg" alt="remove item icon"></button>
        </div>

        <div class="order-total d-flex justify-content-between w-100 align-items-center mt-2">
          <p>Order Total</p>
          <p class="total-costs">$46.50</p>
        </div>
        <p class="carbon-neutral d-flex justify-content-center align-items-center gap-1">
          <img class="me-1" src="../images/icon-carbon-neutral.svg" alt="carbon neutral icon">
          This is a<span>carbon-neutral</span>delivery
        </p>
        <div class="confirm-btn text-center w-100">Confirm Order</div>
      </div>
    </div>
  </div>

  <!-- @include 'scripts.kit' -->
</body>

</html>